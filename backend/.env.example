# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/zenith_fintech

# JWT
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# App
APP_ENV=development
DEBUG=true

# Ask Zenith AI assistant — free Groq key from https://console.groq.com (no card needed).
# Leave blank to run without the assistant (the chat just shows a "not configured" message).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
